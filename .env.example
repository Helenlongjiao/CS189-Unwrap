# Optional. Copy to .env beside docker-compose.yml. Never commit .env.
# The key turns on two extras; without it, both still work the basic way:
#   - AI-written surveys (otherwise the built-in templates)
#   - meaning search in the lost-user guide (otherwise keyword search only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only for regional (data-residency) keys, e.g. US: https://us.api.openai.com/v1
OPENAI_BASE_URL=
